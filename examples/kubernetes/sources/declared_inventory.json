{
  "application": "Istio Bookinfo",
  "basis": "manifest-and-source-derived",
  "description": "Normalized inventory of the pinned Bookinfo deployment, traffic policy, and application call sites used to build the declared selector model.",
  "service_calls": [
    {
      "caller": "productpage_v1",
      "callee": "details_service",
      "evidence": "productpage.py getProductDetails sends GET /details/{product_id}"
    },
    {
      "caller": "productpage_v1",
      "callee": "reviews_service",
      "evidence": "productpage.py getProductReviews sends GET /reviews/{product_id}"
    },
    {
      "caller": "reviews_v2",
      "callee": "ratings_service",
      "evidence": "reviews v2 is built with enable_ratings=true and calls /ratings/{product_id}"
    },
    {
      "caller": "reviews_v3",
      "callee": "ratings_service",
      "evidence": "reviews v3 is built with enable_ratings=true and calls /ratings/{product_id}"
    }
  ],
