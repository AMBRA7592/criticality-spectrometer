{
  "alternatives": [
    {
      "activation_time": 5,
      "replacement": "reviews_v2",
      "requirement_id": "endpoint",
      "source": "modeling assumption: operator changes the route within five minutes",
      "target": "reviews_service"
    }
  ],
  "dependencies": [
    {
      "logic": "OR",
      "requirements": [
        {
          "any_of": [
            "details_v1"
          ],
          "id": "endpoint"
        }
      ],
      "target": "details_service"
    },
    {
      "logic": "OR",
      "requirements": [
        {
          "any_of": [
            "ratings_v1"
          ],
          "id": "endpoint"
        }
      ],
      "target": "ratings_service"
    },
    {
      "logic": "AND",
      "requirements": [
        {
          "any_of": [
            "ratings_service"
          ],
          "id": "ratings"
        }
      ],
      "target": "reviews_v2"
    },
    {
      "logic": "AND",
      "requirements": [
        {
          "any_of": [
            "ratings_service"
          ],
          "id": "ratings"
        }
      ],
      "target": "reviews_v3"
    },
    {
      "logic": "OR",
      "requirements": [
        {
          "any_of": [
            "reviews_v1"
          ],
          "id": "endpoint"
        }
      ],
      "target": "reviews_service"
    },
    {
      "logic": "AND",
      "requirements": [
        {
          "any_of": [
            "client_request"
          ],
          "id": "request"
        },
        {
          "any_of": [
            "details_service"
          ],
          "id": "details"
        },
        {
          "any_of": [
            "reviews_service"
          ],
          "id": "reviews"
        }
      ],
      "target": "productpage_v1"
    },
    {
      "logic": "AND",
      "requirements": [
        {
          "any_of": [
            "productpage_v1"
          ],
          "id": "rendered"
        }
      ],
      "target": "complete_book_page"
    }
  ],
  "description": "Bookinfo observed all-v1 route view: the bounded request selected reviews-v1; a route switch to deployed reviews-v2 is modeled at five minutes.",
