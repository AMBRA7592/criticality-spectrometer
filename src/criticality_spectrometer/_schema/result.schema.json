{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AMBRA7592/criticality-spectrometer/schema/result.schema.json",
  "title": "Criticality Spectrometer Result",
  "description": "A self-identifying sweep report or deterministic bundle of named sweep reports.",
  "x-schema-version": "0.1",
  "oneOf": [
    {"$ref": "#/definitions/report"},
    {
      "type": "object",
      "required": ["result_schema_version", "reports"],
      "additionalProperties": false,
      "properties": {
        "result_schema_version": {"const": "0.1"},
        "reports": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/definitions/report"}
        }
      }
    }
  ],
  "definitions": {
    "report": {
      "type": "object",
      "required": [
        "result_schema_version",
        "instrument",
        "model",
        "run",
        "baseline",
        "nodes"
      ],
      "additionalProperties": false,
      "properties": {
        "result_schema_version": {"const": "0.1"},
        "instrument": {
          "type": "object",
          "required": ["name", "version"],
          "additionalProperties": false,
          "properties": {
            "name": {"const": "criticality-spectrometer"},
            "version": {"type": "string", "minLength": 1}
          }
        },
        "model": {
          "type": "object",
          "required": ["name", "version", "schema_version", "sha256"],
          "additionalProperties": false,
          "properties": {
            "name": {"type": "string"},
            "version": {"type": "string"},
            "schema_version": {"const": "0.1"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "run": {
          "type": "object",
          "required": ["horizons", "compute_or_gap", "include_policy"],
          "additionalProperties": false,
          "properties": {
            "horizons": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "number", "minimum": 0}
            },
            "compute_or_gap": {"type": "boolean"},
            "include_policy": {"type": "boolean"}
          }
        },
        "baseline": {"type": "integer", "minimum": 1},
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["impact", "shape", "or_survival_gap"],
            "additionalProperties": false,
            "properties": {
              "impact": {
                "type": "array",
                "items": {"type": "integer", "minimum": 0}
              },
              "shape": {
                "type": "string",
                "enum": [
                  "none",
                  "persistent",
                  "fully_adaptable",
                  "partially_adaptable"
                ]
              },
              "or_survival_gap": {
                "type": "array",
                "items": {"type": "integer", "minimum": 0}
              },
              "policy_verb": {"type": "string"}
            }
          }
        }
      }
    }
  }
}

